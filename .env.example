# System Settings
PROJECT_NAME="CogniFlip"
VERSION="1.0.0"

# AI & Voice Providers
GROQ_API_KEY=gsk_

# Database
DATABASE_URL=postgresql://

# Auth
# Generate independently:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OTP_PEPPER=
JWT_ISSUER=cogniflip-api
JWT_AUDIENCE=cogniflip-web
ACCESS_TOKEN_MINUTES=15

# Encrypted local fallback:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FALLBACK_ENCRYPTION_KEY=

# Distributed rate limiting. Configure trusted proxy CIDRs only when the
# upstream proxy strips inbound X-Forwarded-For and writes its own value.
REDIS_URL=redis://localhost:6379/0
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
CORS_ORIGINS=https://cogniflip-demo.vercel.app,http://localhost:3000
DEMO_LOGIN_ENABLED=false

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CogniFlip <no-reply@cogniflip.com>"
